{
  "entities": {
    "waitlist_entries": {
      "title": "Waitlist Entry",
      "description": "User information for the AutoThinker X beta waitlist.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "wtp": {
          "type": "string",
          "enum": ["$0 – I'd only use free", "$1‑$5 per blueprint", "$6‑$10 per blueprint", "$11‑$15 per month (unlimited)", "$20+ per month"],
          "description": "What would you pay for a complete venture blueprint?"
        },
        "excitedFeature": {
          "type": "string",
          "enum": ["Competitor analysis", "Pitch deck", "Financial model", "MVP outline"],
          "description": "Which feature excites you most?"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the entry was created"
        }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "waitlist_entries/{entryId}": {
      "schema": "waitlist_entries",
      "description": "Collection of waitlist signups"
    }
  }
}
